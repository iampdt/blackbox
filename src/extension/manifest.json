{
  "manifest_version": 3,
  "name": "Blackbox: API flight recorder",
  "short_name": "Blackbox",
  "version": "0.1.0",
  "description": "Records every API call a web app makes and replays them, so the app keeps working when its backend doesn't.",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Blackbox", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "devtools_page": "devtools.html",
  "permissions": ["scripting", "storage", "unlimitedStorage", "activeTab"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["*://*/*"]
}
