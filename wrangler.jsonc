{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blackbox",
  "main": "site/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "dist/site",
    // Only the sample app's API reaches the Worker; pages and scripts are static files.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "Session" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }],
  "observability": { "enabled": true }
}
